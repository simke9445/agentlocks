{
  "name": "agentlocks",
  "version": "0.5.1",
  "description": "Agent-native advisory file locks that let multiple AI coding agents share one Git worktree without clobbering each other.",
  "license": "MIT",
  "author": "Djordje Simovic",
  "type": "module",
  "packageManager": "bun@1.3.13",
  "homepage": "https://github.com/simke9445/agentlocks#readme",
  "bugs": {
    "url": "https://github.com/simke9445/agentlocks/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simke9445/agentlocks.git"
  },
  "keywords": [
    "advisory-lock",
    "file-lock",
    "multi-agent",
    "ai-agents",
    "coding-agent",
    "claude-code",
    "codex",
    "agent-native",
    "git",
    "worktree",
    "concurrency",
    "cli",
    "typescript",
    "bun"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "agentlocks": "bin/agentlocks.ts"
  },
  "files": [
    "assets/",
    "bin/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "bun run typecheck",
    "agentlocks": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "doctor": "bun run src/index.ts doctor",
    "format": "biome format --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "check": "bun run test && bun run typecheck && bun run lint"
  },
  "dependencies": {
    "commander": "14.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/bun": "1.3.13",
    "typescript": "6.0.3"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
